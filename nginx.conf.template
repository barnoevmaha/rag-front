server {
    # Railway (and most PaaS platforms) inject their own PORT and expect
    # the process to bind to it - never assume 80. $PORT is substituted at
    # container startup by nginx's official envsubst-on-templates hook (see
    # Dockerfile: NGINX_ENVSUBST_FILTER whitelists exactly this variable,
    # so nginx's own $host/$remote_addr/etc. below are never touched).
    listen ${PORT};
    server_name _;

    # By default nginx resolves a proxy_pass hostname ONCE, when it parses
    # this config at startup - if that hostname (e.g. a Railway private
    # service) isn't in DNS yet at that exact moment, nginx crashes with
    # "host not found in upstream" and refuses to start at all. Railway has
    # no guaranteed startup ordering between services, so that's a real
    # risk. The fix: declare a resolver and put the backend URL in a
    # variable rather than a literal in proxy_pass (below) - this makes
    # nginx resolve lazily, per request, instead of once at startup.
    # $NGINX_LOCAL_RESOLVERS is set automatically by the official nginx
    # image's own entrypoint script before this template is rendered - it
    # reads /etc/resolv.conf, so it's always correct for wherever this is
    # actually running.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    root /usr/share/nginx/html;
    index index.html;

    # $BACKEND_INTERNAL_URL is also substituted at startup. Locally (docker
    # compose) it defaults to http://backend:8000 - the compose service
    # name. On Railway it must instead point at the backend's private
    # domain, e.g. http://backend.railway.internal:8000, since Railway has
    # no bare-hostname service DNS the way Compose does.
    location /api/ {
        set $backend ${BACKEND_INTERNAL_URL};
        proxy_pass $backend/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA routing: unknown paths fall back to index.html so React Router
    # handles them client-side instead of nginx returning a 404.
    location / {
        try_files $uri /index.html;
    }
}
